# Copy this file to .env and fill in real values before deploying publicly.
# A working .env with local dev defaults is already included in this project.
PORT=4000
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
NODE_ENV=production

# Comma-separated list of origins allowed to call this API in production.
# Leave blank for local development / same-origin deployment.
CORS_ORIGIN=https://yourdomain.com

# Public URL this app is reachable at — used in verification/reset emails.
APP_URL=https://yourdomain.com

# SMTP settings — required for real emails (verification, password reset).
# Example using Gmail: host smtp.gmail.com, port 587, an "app password"
# (not your regular Gmail password) as SMTP_PASS.
# Or use a transactional provider like SendGrid, Mailgun, Resend, etc.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="GST OneClick <no-reply@yourdomain.com>"
